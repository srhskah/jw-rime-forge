# GitHub OAuth App credentials
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypted session cookie secret (≥32 characters)
# Also accepted as NEXTAUTH_SECRET for familiarity
SESSION_SECRET=please-change-me-to-a-long-random-string-32+

# Optional: public app origin (defaults to request host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
